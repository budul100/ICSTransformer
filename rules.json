{
	"sources": [
		{
			"name": "TravelPerk – Stays",
			"match": {
				"field": "PRODID",
				"pattern": ".*travelperk.*"
			},
			"event_match": {
				"field": "SUMMARY",
				"pattern": "Stay at"
			},
			"geo_swapped": true,
			"expand_nightly": {
				"time_start": "22:00",
				"time_end": "08:00",
				"mode": "series"
			},
			"rules": [
				{
					"field": "SUMMARY",
					"pattern": ".+Stay at (.+)",
					"replace": "Hotel: \\1"
				},
				{
					"field": "CATEGORIES",
					"set": "@Reise"
				},
				{
					"field": "X-MICROSOFT-CDO-BUSYSTATUS",
					"set": "OOF"
				}
			]
		},
		{
			"name": "TravelPerk – Flights",
			"match": {
				"field": "PRODID",
				"pattern": ".*travelperk.*"
			},
			"event_match": {
				"field": "SUMMARY",
				"pattern": "Flight to"
			},
			"geo_swapped": true,
			"rules": [
				{
					"field": "LOCATION",
					"copy_from": "SUMMARY",
					"pattern": ".*Flight to: .+ from .+\\((.+)\\)",
					"replace": "[\\1]"
				},
				{
					"field": "SUMMARY",
					"pattern": ".*Flight to: (\\S.*\\S) from (\\S.+\\S)\\s*\\(.*",
					"replace": "Flight: \\2 -> \\1"
				},
				{
					"field": "CATEGORIES",
					"set": "@Reise"
				},
				{
					"field": "X-MICROSOFT-CDO-BUSYSTATUS",
					"set": "OOF"
				}
			]
		},
		{
			"name": "TravelPerk – Trains",
			"match": {
				"field": "PRODID",
				"pattern": ".*travelperk.*"
			},
			"event_match": {
				"field": "SUMMARY",
				"pattern": "Train to"
			},
			"geo_swapped": true,
			"rules": [
				{
					"field": "SUMMARY",
					"copy_from": "DESCRIPTION",
					"pattern": "From: (.+?) \\d+:\\d+[AP]M\\nTo: (.+?) \\d+:\\d+[AP]M[\\s\\S]*",
					"replace": "Trip: \\1 -> \\2"
				},
				{
					"field": "CATEGORIES",
					"set": "@Reise"
				},
				{
					"field": "X-MICROSOFT-CDO-BUSYSTATUS",
					"set": "OOF"
				}
			]
		},
		{
			"name": "calovo – ALBA Home",
			"match": {
				"field": "PRODID",
				"pattern": ".*calovo.*"
			},
			"event_match": {
				"field": "SUMMARY",
				"pattern": "^ALBA BERLIN\\s*-\\s"
			},
			"exclusive": true,
			"rules": [
				{
					"field": "SUMMARY",
					"pattern": "^ALBA BERLIN\\s*-\\s*([^|]+?)\\s*\\|\\s*([^|]+?)\\s*(?:\\|.*)?$",
					"replace": "Live: \\2 - ALBA Berlin vs. \\1"
				},
				{
					"field": "SUMMARY",
					"pattern": "^Live:\\seasyCredit\\sBBL\\s(.*)$",
					"replace": "Live: BBL \\1"
				},
				{
					"field": "SUMMARY",
					"pattern": "^Live:\\sBasketball\\sChampionsLeague\\s(.*)$",
					"replace": "Live: BCL \\1"
				},
				{
					"field": "LOCATION",
					"pattern": "^\\s*calovo\\.de\\s*\\|\\s*(.*)$",
					"replace": "\\1"
				},
				{
					"field": "DESCRIPTION",
					"set": "Weitere Infos unter https://www.albaberlin.de/spielplan/"
				},
				{
					"field": "CATEGORIES",
					"set": "@Sport"
				},
				{
					"field": "CLASS",
					"set": "PRIVATE"
				},
				{
					"field": "TRANSP",
					"set": "OPAQUE"
				},
				{
					"field": "X-MICROSOFT-CDO-BUSYSTATUS",
					"set": "OOF"
				},
				{
					"field": "X-MICROSOFT-CDO-INTENDEDSTATUS",
					"set": "OOF"
				},
				{
					"field": "URL",
					"delete": true
				}
			]
		}
	],
	"global_rules": [
		{
			"field": "DESCRIPTION",
			"pattern": "\\r\\n",
			"replace": "\\n"
		},
		{
			"field": "DESCRIPTION",
			"pattern": "\\n\\s*\\n",
			"replace": "\\n\\n"
		},
		{
			"field": "DESCRIPTION",
			"pattern": "\\n\\n\\n",
			"replace": "\\n\\n"
		},
		{
			"field": "SUMMARY",
			"pattern": "\\n",
			"replace": " "
		},
		{
			"field": "ATTENDEE",
			"delete": true
		},
		{
			"field": "ORGANIZER",
			"delete": true
		}
	]
}
