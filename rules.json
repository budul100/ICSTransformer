{
  "sources": [
    {
      "name": "TravelPerk",
      "match": { "field": "PRODID", "pattern": ".*travelperk.*" },
      "geo_swapped": true,
        "rules": [
        {
          "field": "LOCATION",
          "copy_from": "SUMMARY",
          "pattern": ".*Flight to: .+ from .+\\((.+)\\)",
          "replace": "[\\1]"
        },
        {
          "field": "SUMMARY",
          "pattern": ".*Flight to: (\\S.*\\S) from (\\S.+\\S)\\s*\\(.*",
          "replace": "Flight: \\2 -> \\1"
        },
        {
          "field": "CATEGORIES",
          "set": "@Reise"
        },
        {
          "field": "X-MICROSOFT-CDO-BUSYSTATUS",
          "set": "OOF"
        }
]
    }
  ],
  "global_rules": [
    {
      "field": "DESCRIPTION",
      "pattern": "\\r\\n",
      "replace": "\\n"
    },
    {
      "field": "DESCRIPTION",
      "pattern": "\\n\\s*\\n",
      "replace": "\\n\\n"
    },
    {
      "field": "DESCRIPTION",
      "pattern": "\\n\\n\\n",
      "replace": "\\n\\n"
    },
    {
      "field": "SUMMARY",
      "pattern": "\\n",
      "replace": " "
    },
    { 
      "field": "ATTENDEE", 
      "delete": true 
    },
    {
      "field": "ORGANIZER",
      "delete": true
    }
  ]
}
