{
  "sources": [
    {
      "name": "Perk",
      "match": { "field": "PRODID", "pattern": ".*travelperk.*" },
      "rules": [
        {
          "field": "SUMMARY",
          "pattern": ".*Flight to: (.+) from (.+)\\n\\s*\\((.+)\\)",
          "replace": "Flight: \\2 -> \\1 (\\3)"
        }
      ]
    }
  ],
  "global_rules": [
    {
      "field": "DESCRIPTION",
      "pattern": "\\r\\n",
      "replace": "\\n"
    },
    {
      "field": "ORGANIZER",
      "delete": true
    }
  ]
}
